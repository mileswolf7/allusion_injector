from allusion_engine import get_allusions_for_text

import ipywidgets as widgets
from IPython.display import display

from allusion_engine import get_allusions_for_text

text = widgets.Textarea(
    description="Text:",
    layout=widgets.Layout(width="800px", height="150px")
)

button = widgets.Button(description="Find allusions")
output = widgets.Output()

def run(b):
    with output:
        output.clear_output()
        results = get_allusions_for_text(text.value)

        for i, result in enumerate(results, 1):
            print(f"{i}. {result['ready_allusion']}")
            print(f"   Wikipedia: {result['article']}")
            print()

button.on_click(run)

display(text, button, output)
