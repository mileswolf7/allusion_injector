import json


def markdown_cell(source):
    return {
        "cell_type": "markdown",
        "metadata": {},
        "source": source.splitlines(True),
    }


def code_cell(source):
    return {
        "cell_type": "code",
        "execution_count": None,
        "metadata": {},
        "outputs": [],
        "source": source.splitlines(True),
    }


notebook = {
    "cells": [
        markdown_cell(
            """# Allusion Injector

This notebook provides a browser-based interface for the **Allusion Injector**.

Enter text below and the application will search for allusions using the
existing `allusion_engine.py` code and `wiki_to_use.db` database.

> **Note:** The database must be present in the repository for this notebook
> to work.
"""
        ),

        code_cell(
            """# Import the Allusion Injector engine

from allusion_engine import get_allusions_for_text

print("Allusion Injector loaded successfully.")
"""
        ),

        code_cell(
            """# Create the user interface

import ipywidgets as widgets
from IPython.display import display, HTML


text_input = widgets.Textarea(
    value="",
    placeholder="Enter a passage of text here...",
    description="Text:",
    disabled=False,
    layout=widgets.Layout(
        width="100%",
        height="180px"
    ),
    style={
        "description_width": "60px"
    }
)

find_button = widgets.Button(
    description="Find Allusions",
    button_style="primary",
    icon="search",
    layout=widgets.Layout(
        width="160px",
        height="40px"
    )
)

clear_button = widgets.Button(
    description="Clear",
    button_style="",
    icon="trash",
    layout=widgets.Layout(
        width="100px",
        height="40px"
    )
)

output = widgets.Output()


def display_result(result, number):
    \"\"\"Display one allusion result.\"\"\"

    if isinstance(result, dict):
        title = (
            result.get("ready_allusion")
            or result.get("title")
            or result.get("article")
            or "Allusion"
        )

        article = result.get("article", "")
        score = result.get("score", "")

        html = f"<h4>{number}. {title}</h4>"

        if article and article != title:
            html += f"<p><b>Wikipedia:</b> {article}</p>"

        if score != "":
            html += f"<p><b>Score:</b> {score}</p>"

        display(HTML(html))

        # Display any remaining useful fields.
        excluded = {
            "ready_allusion",
            "title",
            "article",
            "score",
        }

        remaining = [
            (key, value)
            for key, value in result.items()
            if key not in excluded and value not in ("", None)
        ]

        if remaining:
            for key, value in remaining:
                display(
                    HTML(
                        f"<p><b>{key}:</b> {value}</p>"
                    )
                )

    else:
        display(HTML(f"<h4>{number}. {result}</h4>"))


def find_allusions(_):
    \"\"\"Run the Allusion Injector on the entered text.\"\"\"

    with output:
        output.clear_output()

        text = text_input.value.strip()

        if not text:
            display(
                HTML(
                    '<p style="color:#b00020;">'
                    "Please enter some text first."
                    "</p>"
                )
            )
            return

        display(HTML("<h3>Searching for allusions...</h3>"))

        try:
            results = get_allusions_for_text(text)

            if not results:
                display(
                    HTML(
                        "<p>No allusions were found.</p>"
                    )
                )
                return

            display(
                HTML(
                    f"<p>Found <b>{len(results)}</b> result(s).</p>"
                )
            )

            for number, result in enumerate(results, 1):
                display_result(result, number)

        except Exception as error:
            display(
                HTML(
                    "<h3 style='color:#b00020;'>"
                    "An error occurred"
                    "</h3>"
                    f"<pre>{error}</pre>"
                )
            )


def clear_text(_):
    text_input.value = ""
    with output:
        output.clear_output()


find_button.on_click(find_allusions)
clear_button.on_click(clear_text)


display(
    widgets.VBox(
        [
            text_input,
            widgets.HBox(
                [
                    find_button,
                    clear_button,
                ]
            ),
            output,
        ],
        layout=widgets.Layout(width="100%"),
    )
)
"""
        ),

        markdown_cell(
            """## Example

Try a sentence containing a possible literary, historical, biblical, or
cultural allusion.

You can replace the text in the box above and click **Find Allusions**.
"""
        ),

        code_cell(
            """# Example text

text_input.value = (
    "He felt like David facing Goliath, "
    "but he decided to open Pandora's box anyway."
)
"""
        ),
    ],
    "metadata": {
        "kernelspec": {
            "display_name": "Python 3",
            "language": "python",
            "name": "python3",
        },
        "language_info": {
            "name": "python",
            "version": "3.9",
        },
    },
    "nbformat": 4,
    "nbformat_minor": 5,
}


with open("allusion_demo.ipynb", "w", encoding="utf-8") as file:
    json.dump(notebook, file, indent=2)

print("Created allusion_demo.ipynb")
